<Project>

  <PropertyGroup>
    <MajorVersion>1</MajorVersion>
    <MinorVersion>0</MinorVersion>
    <PatchVersion>0</PatchVersion>
    <VersionPrefix>$(MajorVersion).$(MinorVersion).$(PatchVersion)</VersionPrefix>
    <PreReleaseVersionLabel>alpha</PreReleaseVersionLabel>
    <PreReleaseVersionIteration>3</PreReleaseVersionIteration>
    <VersionSuffix Condition=" '$(VersionSuffix)' == '' And '$(PreReleaseVersionLabel)' != '' And '$(ContinuousIntegrationBuild)' != 'true' ">dev</VersionSuffix>
    <VersionSuffix Condition=" '$(VersionSuffix)' == '' And '$(PreReleaseVersionLabel)' != '' And '$(ContinuousIntegrationBuild)' == 'true' ">ci</VersionSuffix>
  </PropertyGroup>

</Project>
