<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.ResxSourceGenerator" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Polly.Core" />
    <PackageReference Include="System.IO.Ports" />
    <PackageReference Include="System.Interactive.Async" />
    <PackageReference Include="System.Reactive.Async" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="*.xml" />
    <EmbeddedResource Update="OpenNettyResources.resx"
                      AsConstants="true"
                      ClassName="OpenNetty.OpenNettyResources"
                      EmitFormatMethods="true"
                      ManifestResourceName="OpenNetty.OpenNettyResources"
                      OmitGetResourceString="true"
                      Public="true" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenNetty.Tests" Key="$(PublicKey)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="OpenNetty" />
    <Using Include="OpenNetty.OpenNettyResources" Alias="SR" />
  </ItemGroup>

</Project>
