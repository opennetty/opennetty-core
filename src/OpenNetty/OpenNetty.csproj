<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Polly.Core" />
    <PackageReference Include="System.IO.Ports" />
    <PackageReference Include="System.Interactive.Async" />
    <PackageReference Include="System.Reactive.Async" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="*.xml" />
    <EmbeddedResource Update="**\*.resx" GenerateSource="true" GenerateResourcesCodeAsConstants="true" />
    <EmbeddedResource Update="**\*.*.resx" GenerateSource="false" GenerateResourcesCodeAsConstants="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="OpenNetty" />
    <Using Include="OpenNetty.OpenNettyResources" Alias="SR" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Update="Meziantou.Analyzer" Version="3.0.316" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Meziantou.Analyzer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
